# Copy to .env.local and fill in. Never commit real keys.
# Leave empty to use the built-in local (browser storage) backend.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional: base URL for pre-generated audio files (e.g. a CDN bucket).
# When empty, the app uses the browser's German text-to-speech voice.
VITE_AUDIO_BASE_URL=
